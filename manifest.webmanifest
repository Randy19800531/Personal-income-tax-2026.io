{
  "id": "./",
  "name": "SA Tax Consultant – Personal Income Tax",
  "short_name": "SA Tax",
  "description": "ITR12-style personal income tax preparation for South African individuals. Works offline; client data stays on the device.",
  "lang": "en-ZA",
  "dir": "ltr",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#13223F",
  "theme_color": "#13223F",
  "categories": ["finance", "business", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Scan a certificate", "short_name": "Scan", "url": "./?view=documents&focus=scan", "icons": [{ "src": "icons/shortcut-96.png", "sizes": "96x96" }] },
    { "name": "Computation", "short_name": "Compute", "url": "./?view=computation", "icons": [{ "src": "icons/shortcut-96.png", "sizes": "96x96" }] },
    { "name": "Clients", "short_name": "Clients", "url": "./?view=clients", "icons": [{ "src": "icons/shortcut-96.png", "sizes": "96x96" }] },
    { "name": "Guided input", "short_name": "Input", "url": "./?view=input", "icons": [{ "src": "icons/shortcut-96.png", "sizes": "96x96" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        { "name": "files", "accept": ["application/pdf", ".pdf", "image/*", "text/plain", ".txt", "text/csv", ".csv", "application/json", ".json", "text/xml", ".xml", "text/html", ".html"] }
      ]
    }
  },
  "screenshots": [
    { "src": "screenshots/phone-dashboard.png", "sizes": "824x1830", "type": "image/png", "form_factor": "narrow", "label": "Dashboard with the current result" },
    { "src": "screenshots/phone-wizard.png", "sizes": "824x1830", "type": "image/png", "form_factor": "narrow", "label": "ITR12 Form Wizard" },
    { "src": "screenshots/phone-more.png", "sizes": "824x1830", "type": "image/png", "form_factor": "narrow", "label": "All sections" },
    { "src": "screenshots/tablet-dashboard.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Tablet and desktop layout" }
  ]
}
